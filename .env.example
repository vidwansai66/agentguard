# AgentGuard Environment Configuration
# Copy to .env and adjust as needed

# Environment: development | production | test
AGENTGUARD_ENV=development

# Server Binding
HOST=127.0.0.1
PORT=8000

# Database
# Default: sqlite:///./agentguard.db
# PostgreSQL alternative: postgresql+psycopg2://user:password@localhost:5432/agentguard
DATABASE_URL=sqlite:///./agentguard.db

# Security & Limits
MAX_EXECUTION_STEPS=20
MAX_TOOL_TIMEOUT_SECONDS=10
RUN_OVERALL_TIMEOUT_SECONDS=60
MAX_TRACE_PAYLOAD_BYTES=32768

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api
